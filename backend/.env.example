# Ngôn ngữ LLM cho tầng dịch (M2) — chỉ đặt trong backend/.env, KHÔNG commit key.
# Provider chính: Gemini qua endpoint OpenAI-compat của Google:
#   MANGA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   MANGA_LLM_API_KEY=<key Google AI Studio>
#   MANGA_LLM_MODEL=gemini-2.0-flash
# Provider khác (tương thích OpenAI) — OpenRouter / DeepSeek / endpoint local:
#   MANGA_LLM_BASE_URL=https://openrouter.ai/api/v1
#   MANGA_LLM_MODEL=google/gemini-2.0-flash-001
# Tuỳ chọn:
#   MANGA_LLM_TIMEOUT_S=120
#   MANGA_LLM_TEMPERATURE=0.3
